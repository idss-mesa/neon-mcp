# neon-mcp environment example. Copy to .env (git-ignored) and fill in; NEVER commit a token.
# Precedence: command-line flag > environment > YAML (--config) > defaults.

# NEON API token (https://data.neonscience.org/myaccount). Required for data files,
# data queries and sample views; everything else works without it.
NEON_MCP_NEON__API_TOKEN=
# NEON_TOKEN=            # accepted fallback (neonUtilities' variable)

# Transport: stdio (local clients) or http (Streamable HTTP at /mcp)
NEON_MCP_SERVER__TRANSPORT=stdio
NEON_MCP_SERVER__BIND_ADDRESS=127.0.0.1
NEON_MCP_SERVER__BIND_PORT=8080
# NEON_MCP_SERVER__PUBLIC_BASE_URL=https://neon-mcp.example.org   # https:// enables per-request X-API-Token

# Downloads (stdio only)
NEON_MCP_DOWNLOADS__DIRECTORY=~/neon-downloads

# Result size budget in bytes of compact JSON
NEON_MCP_LIMITS__MAX_RESULT_BYTES=50000

NEON_MCP_SERVER__LOG_LEVEL=info
